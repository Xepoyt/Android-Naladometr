<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nálada"
        android:textSize="20sp"
        android:layout_marginTop="100dp"
        android:id="@+id/labelNalada"
        android:layout_centerHorizontal="true"
    />
    <SeekBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="10"
        android:id="@+id/slider"
        android:layout_marginTop="20dp"
        android:layout_below="@id/labelNalada"
    />
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/smutnak"
        android:layout_below="@id/slider"
        android:id="@+id/imgSmutnak"
    />
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/veselak"
        android:layout_below="@id/slider"
        android:layout_alignParentRight="true"
    />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Poznámka"
        android:textSize="20sp"
        android:layout_marginTop="60dp"
        android:layout_below="@id/imgSmutnak"
        android:layout_centerHorizontal="true"
        android:id="@+id/labelPoznamka"
    />
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/labelPoznamka"
        android:layout_margin="10dp"
        android:id="@+id/poznamka"
        android:maxLength="250"
    />
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/poznamka"
        android:text="Ulož"
        android:textSize="20sp"
        android:onClick="uloz"
        android:layout_margin="50dp"
        android:layout_centerHorizontal="true"
    />


</RelativeLayout>